```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
env/
requirements.txt.bak

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Build/dist folders
build/
dist/
*.egg-info/

# Coverage reports
.coverage
coverage/
htmlcov/

# OS generated files
.DS_Store
Thumbs.db
```